{
  "schema": "zombiedefend-asset-group/1",
  "category": "hero",
  "group": "girl",
  "title": "Player Girl (hero)",
  "titleZh": "女主角",
  "description": "Chibi girl hero with red cap and backpack. Combat uses the unarmed idle/walk body; owned guns are front-float sprites (player-girl-front-*) that deploy with player-girl-deploy. Static poses are player-girl-front-*-still. Back-float strips are an optional MOVE fallback. Faces WEST unless the key ends in -walk-east/-north/-south or -run-north/-south. v0.31 tower attack is girl-only: player-girl-tower-fire is the preferred west operator still (both fists on invisible handles), player-girl-command is the same braced stance as a backup overwrite of the old one-finger point, and player-girl-tower-fire-strip is an optional 4-frame micro-bob. No mount or gun is baked into these poses.",
  "source": {
    "pixellabCharacterId": "a1c34927-9d88-4f93-be00-0af46d5d4409",
    "sourceFolder": "player-girl"
  },
  "conventions": {
    "facing": "west (zombies come from the left) unless the key says otherwise",
    "frameSize": "92x92 for player strips",
    "origin": "(0.5, 76/92): feet at y=76",
    "strips": "horizontal, frame i at x=i*frameWidth",
    "sustainedFire": "water/bubble/frost/flame fire: play frames [0,loopFrom) once, loop [loopFrom..loopTo] while firing, then (loopTo..end] once",
    "loopFields": "loop=true: whole strip loops; loopFrom/loopTo (inclusive, 0-based) mark the sustain section of a once-strip"
  },
